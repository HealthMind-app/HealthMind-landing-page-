# Copy to .env.local for local development. Set the same names in Vercel
# (Project → Settings → Environment Variables) for Production and Preview.

# Firebase Admin service account (Firestore writes: waitlist, deletion
# requests, unsubscribe, email feedback, rate limits)
FIREBASE_PROJECT_ID=healthmind-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (deletion-request notifications, feedback emails)
RESEND_API_KEY=

# Inbox that receives deletion requests (defaults to support@healthmindgroup.com)
SUPPORT_EMAIL=

# Shared with the app's Cloud Functions; signs unsubscribe links (32+ chars)
UNSUBSCRIBE_TOKEN_SECRET=

# Optional: override the public impact endpoint
HEALTHMIND_IMPACT_API_URL=

# Email feedback system (scripts/)
FEEDBACK_BASE_URL=
FEEDBACK_ENDPOINT_URL=
